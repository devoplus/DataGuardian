{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DataGuardian": {
    "AnalyzeRequests": true,
    "AnalyzeResponses": true,
    "Action": "Tag",
    "LanguageOverride": "tr",
    "EmitHeaders": true
  }
}
